{
  "name": "opencode-usage-limits-sidebar",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "OpenCode TUI plugin that shows OpenCode Go subscription usage in the sidebar using the official usage API",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sidebar",
    "tui",
    "usage",
    "limits",
    "opencode-go"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leleor/opencode-usage-limits-sidebar.git"
  },
  "homepage": "https://github.com/leleor/opencode-usage-limits-sidebar#readme",
  "engines": {
    "opencode": ">=2.0.0"
  },
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/node": "^20.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.0.2",
    "vitest": "^4.1.2"
  }
}
